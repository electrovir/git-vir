{
    "name": "git-vir",
    "version": "2.0.1",
    "description": "CLI tool for making life with git and GitHub easier.",
    "keywords": [],
    "homepage": "https://github.com/electrovir/git-vir",
    "bugs": {
        "url": "https://github.com/electrovir/git-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/git-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": "src/cli/cli.ts",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "virmator test node",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck"
    },
    "dependencies": {
        "@augment-vir/common": "^29.3.0",
        "@augment-vir/node-js": "^29.3.0",
        "cli-args-vir": "^0.0.3",
        "object-shape-tester": "^2.4.0",
        "simple-git": "^3.25.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.1.0",
        "@eslint/js": "^9.9.0",
        "@stylistic/eslint-plugin": "^2.6.2",
        "@stylistic/eslint-plugin-ts": "^2.6.2",
        "@types/node": "^22.3.0",
        "@typescript-eslint/eslint-plugin": "^8.1.0",
        "cspell": "^8.13.3",
        "dependency-cruiser": "^16.3.10",
        "esbuild": "^0.23.0",
        "eslint": "^9.9.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jsdoc": "^50.1.0",
        "eslint-plugin-playwright": "^1.6.2",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^1.0.4",
        "eslint-plugin-unicorn": "^55.0.0",
        "istanbul-smart-text-reporter": "^1.1.4",
        "markdown-code-example-inserter": "^2.0.3",
        "npm-check-updates": "^17.0.6",
        "prettier": "^3.3.3",
        "prettier-plugin-interpolated-html-tags": "^1.0.5",
        "prettier-plugin-jsdoc": "^1.3.0",
        "prettier-plugin-multiline-arrays": "^3.0.6",
        "prettier-plugin-organize-imports": "^4.0.0",
        "prettier-plugin-packagejson": "^2.5.1",
        "prettier-plugin-sort-json": "^4.0.0",
        "prettier-plugin-toml": "^2.0.1",
        "tsx": "^4.17.0",
        "typedoc": "^0.26.5",
        "typescript": "^5.5.4",
        "typescript-eslint": "^8.1.0",
        "virmator": "^13.2.7"
    },
    "engines": {
        "node": ">=22"
    }
}
