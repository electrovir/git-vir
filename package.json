{
    "name": "git-vir",
    "version": "2.1.7",
    "description": "CLI tool for making life with git and GitHub easier.",
    "keywords": [
        "cli",
        "git",
        "chained pull requests",
        "stacked diffs"
    ],
    "homepage": "https://github.com/electrovir/git-vir",
    "bugs": {
        "url": "https://github.com/electrovir/git-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/git-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": "bin.js",
    "scripts": {
        "compile": "virmator compile",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "virmator test node",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.2.1",
        "@augment-vir/common": "^32.2.1",
        "@augment-vir/node": "^32.2.1",
        "object-shape-tester": "^6.14.1",
        "simple-git": "^3.36.0",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@augment-vir/test": "^32.2.1",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^26.1.2",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.0",
        "esbuild": "^0.28.1",
        "eslint": "10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.3.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.6",
        "npm-check-updates": "^23.0.0",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^1.0.6",
        "typedoc": "^0.28.20",
        "typescript-eslint": "^8.65.0",
        "virmator": "^14.30.3"
    },
    "engines": {
        "node": ">=22"
    }
}
