{
    "name": "git-vir",
    "version": "2.0.3",
    "description": "CLI tool for making life with git and GitHub easier.",
    "keywords": [],
    "homepage": "https://github.com/electrovir/git-vir",
    "bugs": {
        "url": "https://github.com/electrovir/git-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/git-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": "bin.js",
    "scripts": {
        "compile": "virmator compile",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "virmator test node",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.3.0",
        "@augment-vir/common": "^31.3.0",
        "@augment-vir/node": "^31.3.0",
        "object-shape-tester": "^4.0.0",
        "simple-git": "^3.27.0",
        "tsx": "^4.19.2"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.3.0",
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "9.17.0",
        "@stylistic/eslint-plugin": "^2.12.1",
        "@stylistic/eslint-plugin-ts": "^2.12.1",
        "@types/node": "^22.10.4",
        "@typescript-eslint/eslint-plugin": "^8.19.0",
        "cspell": "^8.17.1",
        "dependency-cruiser": "^16.8.0",
        "esbuild": "^0.24.2",
        "eslint": "9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jsdoc": "^50.6.1",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.1",
        "eslint-plugin-unicorn": "^56.0.1",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^17.1.13",
        "prettier": "^3.4.2",
        "prettier-plugin-interpolated-html-tags": "^2.0.0",
        "prettier-plugin-jsdoc": "^1.3.0",
        "prettier-plugin-multiline-arrays": "^4.0.1",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-packagejson": "^2.5.6",
        "prettier-plugin-sort-json": "^4.0.0",
