{
    "name": "git-vir",
    "version": "2.0.5",
    "description": "CLI tool for making life with git and GitHub easier.",
    "keywords": [
        "cli",
        "git",
        "chained pull requests",
        "stacked diffs"
    ],
    "homepage": "https://github.com/electrovir/git-vir",
    "bugs": {
        "url": "https://github.com/electrovir/git-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/git-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": "bin.js",
    "scripts": {
        "compile": "virmator compile",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "virmator test node",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.57.3",
        "@augment-vir/common": "^31.57.3",
        "@augment-vir/node": "^31.57.3",
        "object-shape-tester": "^6.11.0",
        "simple-git": "^3.30.0",
        "tsx": "^4.21.0"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.57.3",
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "9.39.2",
        "@stylistic/eslint-plugin": "^5.6.1",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^25.0.3",
        "@typescript-eslint/eslint-plugin": "^8.51.0",
        "cspell": "^9.4.0",
        "dependency-cruiser": "^17.3.5",
        "esbuild": "^0.27.2",
        "eslint": "9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^61.5.0",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.4.0",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.5",
        "eslint-plugin-unicorn": "^62.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^19.2.0",
        "prettier": "^3.4.2",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.0",
        "prettier-plugin-multiline-arrays": "^4.1.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^2.5.20",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^1.0.0",
        "typedoc": "^0.28.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.51.0",
        "virmator": "^14.4.0"
    },
    "engines": {
        "node": ">=22"
    }
}
